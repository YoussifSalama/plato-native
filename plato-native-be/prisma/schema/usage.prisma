// One row per LLM run or Apify actor run. Basis for plan pricing/quotas.
// user_id is the auth User id (null for background work with no request).
model UsageEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id       String?  @db.ObjectId
  feature       String
  model         String?
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  apify_usd     Float    @default(0)
  // Estimated dollars for this event (tokens x price table, or Apify's own figure).
  cost_usd      Float?
  // Extra detail, e.g. a voice call's audio/text token split and seconds.
  meta          Json?
  // The job search (DiscoveryRun) this cost belongs to, so the admin panel can price
  // each search. Null for everything else, and for events from before it was recorded.
  discovery_run_id String? @db.ObjectId
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@index([feature, created_at])
  @@index([discovery_run_id])
  @@map("usage_events")
}

// How a seeker uses the web app, one row per user, UTC day and page: page views and
// seconds on the page (a heartbeat while the tab is visible). Pages are route shapes
// ("/applications/:id"), never ids, queries or what is on the page.
model PageActivity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  day        String
  page       String
  views      Int      @default(0)
  seconds    Int      @default(0)
  first_at   DateTime @default(now())
  last_at    DateTime @default(now())

  @@unique([user_id, day, page])
  @@index([day])
  @@map("page_activity")
}

// usage_events summed per finished calendar day (ADMIN_TZ), seeker, model, Apify-or-not and feature,
// so the admin panel never re-reads every event for past days (usage-rollup.ts writes it with
// $merge; usage-stats.ts reads it). _id = "day|user|model|apify|feature". Days are only ever added.
model UsageDaily {
  id       String  @id @map("_id")
  day      String
  user_id  String? @db.ObjectId
  model    String?
  apify    Boolean
  feature  String
  cost     Float
  events   Int
  input    Int
  output   Int

  @@index([day])
  @@index([user_id, day])
  @@map("usage_daily")
}
