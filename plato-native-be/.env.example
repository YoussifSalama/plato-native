# Copy to .env and fill in. The API checks these at boot and names anything
# missing or malformed (src/config/env/validate-env.ts). Never commit .env.

# --- Required ---------------------------------------------------------------
NODE_ENV=development
DB_URI=                               # MongoDB connection string
JWT_SECRET=                           # 32+ random characters in production
OPENAI_API_KEY=
CLOUDFLARE_ACCESS_KEY_ID=             # R2 storage for CVs and screenshots
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_CLIENT_API=             # https://<account>.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=

# --- Web app and hosting ----------------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:3001    # required in production
API_PUBLIC_URL=                       # optional: one-click unsubscribe header
EXTENSION_ORIGIN=                     # chrome-extension://<id>
TRUST_PROXY=                          # 1 behind one proxy / load balancer

# --- Email (SendGrid): password reset, email confirmation, job alerts --------
SENDGRID_API_KEY=                     # Mail Send permission only
MAIL_FROM=                            # e.g. alerts@yourdomain (verified in SendGrid)
MAIL_FROM_NAME=Plato

# --- Job sources ---------------------------------------------------------------
APIFY_TOKEN=
JOOBLE_API_KEY=
ADZUNA_APP_ID=                        # set both Adzuna keys or neither
ADZUNA_APP_KEY=
DISABLED_BOARDS=
DISCOVERY_APIFY_ATS=                  # false: skip the paid ATS aggregator
MAX_POSTING_AGE_DAYS=30

# --- Admin --------------------------------------------------------------------
ADMIN_REPORT_KEY=                     # x-admin-key for /admin/*; empty = admin routes off

# --- Plato tokens (defaults in src/modules/credits/credit-prices.ts) ----------
CREDITS_USD_PER_TOKEN=
CREDITS_FREE_MONTHLY=
CREDITS_PRO_MONTHLY=
CREDITS_MAX_MONTHLY=
CREDITS_PRO_PRICE_USD=
CREDITS_MAX_PRICE_USD=
CREDITS_TOPUP_SMALL_USD=
CREDITS_TOPUP_MEDIUM_USD=
CREDITS_TOPUP_LARGE_USD=
CREDITS_VOICE_USD_PER_MINUTE=
PAYMENTS_PROVIDER=                    # empty until a payment provider is connected

# --- Background jobs ------------------------------------------------------------
INSIGHTS_JOBS=                        # off: no job-alert timers on this instance
FRESHNESS_CHECK=                      # off: no posting freshness checks

# --- Models (optional overrides) ----------------------------------------------
CHAT_MODEL=
CAREER_MODEL=
CAREER_SEARCH_MODEL=
REALTIME_MODEL=
PROFILE_EXTRACTION_MODEL=
ORCHESTRATOR_MODEL=
TITLE_PLANNER_MODEL=
V3_MODEL=

# --- Apply worker (server-side auto apply) ------------------------------------
APPLY_WORKER_ENABLED=
APPLY_DRY_RUN=
APPLY_CONFIRM_ANSWERS=
APPLY_MAX_ATTEMPTS=
APPLY_BROWSER_CHANNEL=
APPLY_HEADLESS=
APPLY_VERIFICATION_WAIT_SEC=
APPLY_ANSWER_MODEL=
APPLY_RESUME_MODEL=
APPLY_TAILOR_RESUME=
BROWSER_CDP_URL=

# --- Monitoring ------------------------------------------------------------------
SENTRY_DSN=                           # errors are reported to Sentry when set
SENTRY_ENVIRONMENT=
