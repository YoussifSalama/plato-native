# Two hostnames, both from .env (WEB_DOMAIN = the web app, API_DOMAIN = the API). Caddy fetches and renews the certificates itself.
{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3001
}

{$API_DOMAIN} {
	encode gzip
	# the extension posts screenshots (a few MB) per turn
	request_body {
		max_size 16MB
	}
	reverse_proxy api:3000
}
