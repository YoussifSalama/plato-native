# Hostnames come from .env. Caddy fetches and renews every certificate itself.
#   WEB_DOMAIN      the job-seeker web app (app.platohiring.com)
#   API_DOMAIN      the API (api.platohiring.com)
#   LANDING_DOMAIN  the bare domain (platohiring.com): redirects to the app until a landing page exists

{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3001
}

{$API_DOMAIN} {
	encode gzip
	# the extension posts screenshots (a few MB) per turn
	request_body {
		max_size 16MB
	}
	reverse_proxy api:3000
}

# The bare domain and www: a landing page later; a redirect to the app for now.
{$LANDING_DOMAIN}, www.{$LANDING_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
