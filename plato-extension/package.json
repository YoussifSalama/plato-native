{
  "name": "plato-extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --flavor=production",
    "build:fixtures": "node scripts/build.mjs --flavor=fixtures",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "node scripts/build.mjs --flavor=fixtures && node test/runtime/run.mjs",
    "test:runtime:v3": "node scripts/build.mjs --flavor=fixtures --engine=v3 --out=dist/fixtures-v3 && node test/runtime/v3.mjs",
    "lint": "eslint .",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
