// Plato tokens: the seeker's spending balance. One account per auth User; every
// metered usage event (usage_events) is converted to tokens by its real cost and
// written to the ledger. See src/modules/credits/credit-prices.ts for the rates.
model CreditAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @unique @db.ObjectId
  plan         String   @default("free")
  // Plato tokens left in this period. Fractional (a cheap chat message is
  // ~1 token); may dip slightly below zero when a call finishes after the
  // balance ran out. Reset to the plan's grant at period_end.
  balance      Float    @default(0)
  // Tokens bought as top-ups, included in balance. They are spent last and
  // never expire: what is left of them, min(topup, balance), carries over
  // the monthly reset and a plan change.
  topup        Float    @default(0)
  period_start DateTime
  period_end   DateTime
  // A paid plan set by hand (no payments yet) lapses to Free at the first
  // period end on or after this date, instead of refilling forever.
  paid_until   DateTime?
  // Opened before the email was confirmed: no monthly grant until it is (the
  // grant lands on the first read after). Unset on every other account.
  unverified   Boolean?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("credit_accounts")
}

// Every change to a balance, append-only: grant (plan grant or monthly reset),
// consume (a metered usage event), hold / release (a reservation), topup (a bought
// pack), adjust (admin).
model CreditLedger {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String   @db.ObjectId
  kind           String
  // Signed: negative for consume.
  amount         Float
  balance_after  Float
  feature        String?
  usage_event_id String?  @db.ObjectId
  // A hold (tokens reserved before a call whose cost is known only after it:
  // a voice interview, a job-board run) is settled once: released back, and
  // the real cost (never more than the hold) charged as a consume.
  // meta.until (epoch ms): after it an unsettled hold is released.
  settled_at     DateTime?
  meta           Json?
  created_at     DateTime @default(now())

  @@index([user_id, created_at])
  // the admin panel prices a search from its usage events' ledger rows
  @@index([usage_event_id])
  @@map("credit_ledger")
}
