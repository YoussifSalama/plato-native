model JobSeekerPreference {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @unique @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  email_notifications Boolean @default(true)
  push_notifications  Boolean @default(true)
  ai_recommendations  Boolean @default(true)

  roles                String[] @default([])
  preferred_job_types  String[]
  preferred_industries String[]
  preferred_locations  String[]
  work_setup           String[] @default([])
  salary_min           Int?
  salary_max           Int?
  salary_currency      String?
  salary_period        String   @default("MONTHLY")
  things_to_avoid      String?
  source               String   @default("AI_SUGGESTED")

  seniority                 String?
  years_experience          String?
  availability              String?
  employment_status         String?
  willing_to_relocate       Boolean @default(false)
  visa_sponsorship_required Boolean @default(false)
