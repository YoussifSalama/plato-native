# Copy to /opt/plato/.env on the server (and to ./.env for a local smoke test). Never commit it.
# docker-compose.yml reads LANDING_DOMAIN, WEB_DOMAIN, API_DOMAIN, ADMIN_DOMAIN, MONGO_ROOT_PASSWORD, SUPER_ADMIN_EMAIL and SUPER_ADMIN_KEY;
# everything else goes to the API as is.
# DB_URI, FRONTEND_URL, API_PUBLIC_URL, ADMIN_URL, PORT and TRUST_PROXY are set by the compose file: do not put them here.

# --- Hosting -------------------------------------------------------------------
LANDING_DOMAIN=plato.example.com
WEB_DOMAIN=job.plato.example.com
API_DOMAIN=api.plato.example.com
ADMIN_DOMAIN=admin.plato.example.com   # the admin panel
MONGO_ROOT_PASSWORD=
EXTENSION_ORIGIN=chrome-extension://khlefnjhigieijnbjhgfedpmenobcope   # same id for the Web Store and unpacked builds
COOKIE_DOMAIN=.plato.example.com   # parent of WEB_DOMAIN and API_DOMAIN, so the web app sees the login cookie

# --- Required by the API (see plato-native-be/.env.example for the full list) -----
JWT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_CLIENT_API=
CLOUDFLARE_BUCKET_NAME=

# --- Email ---------------------------------------------------------------------
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# --- Job sources ---------------------------------------------------------------
APIFY_TOKEN=
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Fantastic.jobs trial (paid, 1 credit per job returned). Off unless both are set.
USE_FANTASTIC_JOBS=false               # true = Fantastic.jobs ONLY (no Apify, feeds or index), to compare
FANTASTIC_JOBS_API_KEY=
FANTASTIC_JOBS_LIMIT=100              # jobs (= credits) per search, max 1000
FANTASTIC_JOBS_TIME_FRAME=6m          # 1h | 24h | 7d | 6m indexing window; "posted" is still capped by MAX_POSTING_AGE_DAYS

# --- Admin / monitoring --------------------------------------------------------
# The one super admin: signing up in the admin panel with this email asks for the key below. Both are required.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_KEY=                       # long random value, e.g. from `openssl rand -hex 32`; keep it secret
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Boards to skip: BOARD or BOARD:COUNTRY (e.g. DICE,TALENT,GOOGLE_JOBS:EG)
DISABLED_BOARDS=DICE,TALENT,GOOGLE_JOBS:EG
APIFY_MAX_CONCURRENT_RUNS=5            # Apify runs at once; raise with the Apify plan memory
APIFY_RUN_TIMEOUT_SECS=180               # an Apify run is aborted after this; what it found is kept
BOARD_MAX_RUNS=16                       # Apify board runs per search (best title in every market first)
