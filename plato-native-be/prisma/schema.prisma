// ========== datasource.prisma ==========

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DB_URI")
}

// ========== admin.prisma ==========

// Admin panel accounts (plato-admin). Separate from seekers (User): their own
// collection, session cookie, JWT audience and signing key.
model AdminUser {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  // Stored lowercase.
  email         String  @unique
  password_hash String
  // The one account named by SUPER_ADMIN_EMAIL: every page, manages admins. Never set through the API.
  is_super      Boolean @default(false)
  // Invited admins start inactive until a super admin turns them on.
  active        Boolean @default(false)
  role_id       String?    @db.ObjectId
  role          AdminRole? @relation(fields: [role_id], references: [id])

  // TOTP (RFC 6238) base32 secret, set once the first code is verified.
  totp_secret         String?
  // Shown as a QR during setup, promoted to totp_secret on the first good code.
  totp_pending_secret String?
  // Sessions (and half-way logins) issued before this are refused.
  sessions_valid_after DateTime?
  last_login_at        DateTime?

  invites_sent AdminInvite[] @relation("AdminInviteSender")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admin_users")
}

// A named set of admin pages (permission keys in src/modules/admin/admin-pages.ts).
// "admin" (admins, roles, invites) is never stored here: super admin only.
model AdminRole {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String   @unique
  pages String[] @default([])

  admins  AdminUser[]
  invites AdminInvite[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admin_roles")
}

// An invitation link sent by the super admin. Only the token's SHA-256 is stored.
// used_at / revoked_at are written as explicit nulls on create: Mongo's null filter does not match a missing field.
model AdminInvite {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  // Stored lowercase.
  email      String
  role_id    String?    @db.ObjectId
  role       AdminRole? @relation(fields: [role_id], references: [id])
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  revoked_at DateTime?
  invited_by String?    @db.ObjectId
  inviter    AdminUser? @relation("AdminInviteSender", fields: [invited_by], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@map("admin_invites")
}

// Who did what in the admin panel: every successful write by a signed-in admin, each sign-in and
// each super-key reset. Append-only; read by the super admin (Team > Audit log).
model AdminAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  admin_id    String?  @db.ObjectId
  admin_email String?
  // "POST /admin/users/:id/block" (the route, not the filled-in URL)
  action      String
  // the route's ids, e.g. { id: "<user id>" }
  target      Json?
  // the request body, secrets removed, at most 8 KB
  detail      Json?
  ip          String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([admin_id, created_at])
  @@map("admin_audit_logs")
}

// ========== auth.prisma ==========

enum AuthTokenKind {
    RESET_PASSWORD
    VERIFY_EMAIL
    // A new address for the account: the swap happens when the link sent to it is opened.
    CHANGE_EMAIL
}

// One-time links sent by email. Only a hash of the secret is stored, so a
// database read can't be turned into a working link.
model AuthToken {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String        @db.ObjectId
  kind       AuthTokenKind
  token_hash String        @unique
  expires_at DateTime
  // Written as an explicit null on create: Mongo's null filter does not match a missing field.
  used_at    DateTime?
  // CHANGE_EMAIL: the address the link was sent to.
  email      String?

  created_at DateTime @default(now())

  @@index([user_id, kind])
  @@map("auth_tokens")
}

// ========== career.prisma ==========

// The Career assistant: its own chat, separate from the job-search threads.

model CareerThread {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  title String?
  messages CareerMessage[]
  resumes  CareerResume[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id, updated_at])
  @@map("career_threads")
}

model CareerMessage {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  thread_id String       @db.ObjectId
  thread    CareerThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  role    ChatRole
  content String
  // Rich result shown under the message, e.g. { type: "resume", resumeId, title }.
  ui      Json?

  created_at DateTime @default(now())

  @@index([thread_id, created_at])
  @@map("career_messages")
}

// A resume Plato built in the Career chat (PDF in object storage).
model CareerResume {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  thread_id String?       @db.ObjectId
  thread    CareerThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)

  title        String
  target_role  String?
  storage_key  String
  // How the resume was built: market, stage, format, pages, template, checks.
  strategy     Json?

  // The document the PDF was drawn from, so it can be edited and redrawn.
  doc             Json?
  // The posting it was tailored to, kept to regenerate a bullet for the same job.
  job_description String?
  // Set when the resume was made for one job (Jobs → Tailor & apply). Approval is
  // then per job, and applying to that job uploads this file.
  job_id          String?  @db.ObjectId
  // Versions of the resume for one target role: 1, 2, 3... A new edit is a new version.
  version         Int      @default(1)
  parent_id       String?  @db.ObjectId
  // The one version per role the seeker approved for applications.
  approved        Boolean  @default(false)
  edited          Boolean  @default(false)

  created_at DateTime @default(now())

  @@index([job_seeker_id, created_at])
  @@map("career_resumes")
}

// ========== chat.prisma ==========

enum ChatRole {
    USER
    ASSISTANT
}

// One thread = one job-search conversation. Notifications and results link
// back to a thread id, so it doubles as the "search session" id.
model ChatThread {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  title String?

  messages       ChatMessage[]
  discovery_runs DiscoveryRun[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id, created_at])
  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  thread_id String     @db.ObjectId
  thread    ChatThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  role    ChatRole
  content String
  // Interactive card the assistant attached (questions to answer in the
  // chat UI). Answers come back as the next user message.
  ui      Json?

  created_at DateTime @default(now())

  @@index([thread_id, created_at])
  @@map("chat_messages")
}

// ========== credits.prisma ==========

// Plato tokens: the seeker's spending balance. One account per auth User; every
// metered usage event (usage_events) is converted to tokens by its real cost and
// written to the ledger. See src/modules/credits/credit-prices.ts for the rates.
model CreditAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @unique @db.ObjectId
  plan         String   @default("free")
  // Plato tokens left in this period. Fractional (a cheap chat message is
  // ~1 token); may dip slightly below zero when a call finishes after the
  // balance ran out. Reset to the plan's grant at period_end.
  balance      Float    @default(0)
  // Tokens bought as top-ups, included in balance. They are spent last and
  // never expire: what is left of them, min(topup, balance), carries over
  // the monthly reset and a plan change.
  topup        Float    @default(0)
  period_start DateTime
  period_end   DateTime
  // A paid plan set by hand (no payments yet) lapses to Free at the first
  // period end on or after this date, instead of refilling forever.
  paid_until   DateTime?
  // Opened before the email was confirmed: no monthly grant until it is (the
  // grant lands on the first read after). Unset on every other account.
  unverified   Boolean?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("credit_accounts")
}

// Every change to a balance, append-only: grant (plan grant or monthly reset),
// consume (a metered usage event), hold / release (a reservation), topup (a bought
// pack), adjust (admin).
model CreditLedger {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String   @db.ObjectId
  kind           String
  // Signed: negative for consume.
  amount         Float
  balance_after  Float
  feature        String?
  usage_event_id String?  @db.ObjectId
  // A hold (tokens reserved before a call whose cost is known only after it:
  // a voice interview, a job-board run) is settled once: released back, and
  // the real cost (never more than the hold) charged as a consume.
  // meta.until (epoch ms): after it an unsettled hold is released.
  settled_at     DateTime?
  meta           Json?
  created_at     DateTime @default(now())

  @@index([user_id, created_at])
  // the admin panel prices a search from its usage events' ledger rows
  @@index([usage_event_id])
  @@map("credit_ledger")
}

// ========== enum.prisma ==========

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum JobSeekerDocumentType {
    CV_RESUME
    CERTIFICATE
    LICENSE
    DEGREE
    OTHER
    // Onboarding's "other documents" (owner screen 01). Stored only; Plato attaches
    // one when a form asks for it.
    COVER_LETTER
    PORTFOLIO
    WORK_PERMIT
    ID_DOCUMENT
    REFERENCE_LETTER
}

enum JobSeekerDocumentStatus {
    UPLOADED
    PROCESSING
    TEXT_EXTRACTED
    READY
    FAILED
}

enum SectionStatus {
    LOOKS_GOOD
    NEEDS_ATTENTION
}

// ========== error-log.prisma ==========

// Every API response with status >= 400 (and every uncaught error), plus errors
// the browser extension reports itself (POST /extension/v1/errors). Shown in the
// admin panel's Logs page. data = query + redacted body, at most 8 KB.
model ErrorLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // "web" (the seeker app sent x-plato-page) | "extension" | "api"
  platform    String
  // "server" (a response) | "client" (the extension reported it)
  source      String   @default("server")
  module      String
  page        String?
  method      String
  path        String
  // 0 for a client report (no HTTP response)
  status      Int
  code        String?
  message     String
  explanation String?
  data        Json?
  user_id     String?  @db.ObjectId
  user_email  String?
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([platform, created_at])
  @@index([module])
  @@index([status])
  @@index([user_id])
  @@map("error_logs")
}

// ========== guest.prisma ==========

// A visitor using the public /search page before having an account: their CV, what Plato read from it, and their
// searches. Known by a random token in an httpOnly cookie on their device (only its hash is stored). On signup or login
// from that device it all moves onto the account and the row is deleted. Unclaimed rows are deleted after 7 days.
model Guest {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  token_hash String  @unique
  ip         String?
  user_agent String?

  cv_storage_key String?
  cv_name        String?
  cv_mime        String?
  cv_text        String?
  cv_uploads     Int     @default(0)
  // CvAnalysis: extraction + section statuses + findings, as onboarding's analyze makes them.
  analysis       Json?
  // The preference suggestion read from the CV (roles, locations, seniority...).
  suggestion     Json?

  // The open jobs the visitor ticked: saved on the account when it is claimed.
  picked_job_ids String[] @default([]) @db.ObjectId

  searches GuestSearch[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ip, created_at])
  @@index([created_at])
  @@map("guests")
}

// One guest search: LinkedIn only. The visitor sees the first two jobs; the rest stay on the server until claimed.
model GuestSearch {
  id       String             @id @default(auto()) @map("_id") @db.ObjectId
  guest_id String             @db.ObjectId
  guest    Guest              @relation(fields: [guest_id], references: [id], onDelete: Cascade)
  status   DiscoveryRunStatus @default(RUNNING)
  query    Json
  // Best first (BM25 against the CV); the first two are the open ones.
  job_ids  String[]           @default([]) @db.ObjectId
  error    String?
  // Live progress for the page while it runs: { phase, runs: [{ title, place, count }], found, kept }.
  progress Json?

  created_at DateTime @default(now())

  @@index([guest_id, created_at])
  @@index([created_at])
  @@map("guest_searches")
}

// ========== insights.prisma ==========

// Job alerts ("insights"): a seeker asks to hear about new jobs in a field or
// at companies they follow. New jobs from any source (other seekers' searches
// included, the scheduled backfill too) are matched as they enter the index,
// held as AlertMatch rows, and sent together in one digest on the seeker's
// cadence. Never one message per job, never a closed job.

enum AlertKind {
    FIELD
    COMPANY
}

enum AlertCadence {
    DAILY
    EVERY_3_DAYS
    WEEKLY
}

model JobAlert {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  kind          AlertKind

  // FIELD: the role asked for ("Frontend Engineer"), and optionally where.
  title       String?
  location    String?
  remote_only Boolean?
  // COMPANY: the shown name and its comparison key (normalizeCompany).
  company     String?
  company_key String?

  paused Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id])
  @@index([company_key])
  @@map("job_alerts")
}

// One new job for one seeker. Unique per (seeker, job): two alerts that both
// match the same posting still send it once, and a sent job is never sent again.
model AlertMatch {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  alert_id      String   @db.ObjectId
  job_id        String   @db.ObjectId

  // Set when it went out in a digest, or when it was dropped before sending
  // (closed, too old, or unverifiable and not recent). Written as explicit
  // nulls on create: Mongo's null filter does not match a missing field.
  digest_id  String?   @db.ObjectId
  sent_at    DateTime?
  dropped    String?

  created_at DateTime @default(now())

  @@unique([job_seeker_id, job_id])
  @@index([job_seeker_id, sent_at])
  @@map("alert_matches")
}

// How and how often a seeker hears about their alerts.
model AlertSettings {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String       @unique @db.ObjectId
  cadence       AlertCadence @default(EVERY_3_DAYS)
  email         Boolean      @default(true)
  in_app        Boolean      @default(true)
  // Secret for the one-click unsubscribe link in every email.
  unsubscribe_token String   @unique
  last_digest_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("alert_settings")
}

// One digest that went out: the stored in-app notification, and what the email listed.
model AlertDigest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  job_ids       String[] @db.ObjectId
  // Short "3 new React jobs, 2 at Stripe" style summary, made at send time.
  headline      String
  emailed       Boolean  @default(false)

  created_at DateTime @default(now())

  @@index([job_seeker_id, created_at])
  @@map("alert_digests")
}

// Where the matcher got to in the job index (Job.created_at), so each job is matched once.
model InsightsCursor {
  id  String   @id @default(auto()) @map("_id") @db.ObjectId
  key String   @unique
  at  DateTime

  @@map("insights_cursors")
}

// The "to follow" catalogue (FOLLOWING.md 2.1): employers seekers follow and where each publishes its jobs, so the
// company crawler can fetch them without anyone searching. One per company key (normalizeCompany). Filled from the
// curated sheet (data/company_sources.csv), from job boards our searches found, and from companies seekers follow.
model CompanySource {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  company_key String   @unique
  name        String
  aliases     String[] @default([])
  countries   String[] @default([])
  website     String?
  // [{ type, ref, verified, status: active|broken|unverified, fails, last_ok_at, last_error }]
  sources     Json     @default("[]")
  // Active COMPANY follows, and how often the crawler visits: hot 6 h, warm daily, cold weekly.
  followers   Int      @default(0)
  tier        String   @default("cold")
  added_by    String // sheet | auto | seeker
  last_crawled_at DateTime?
  last_new_job_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tier, last_crawled_at])
  @@map("company_sources")
}

// ========== interview.prisma ==========

// A text mock interview for a listed job, a pasted job post or a role in general.
// Questions are generated once; a retry copies them into a new session.
model MockInterview {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  // Snapshot of the job: the posting may later expire or change.
  job_id          String? @db.ObjectId
  job_title       String
  company         String
  job_description String

  // [{ kind, question, answer?, followUp?, followUpAnswer?, feedback? }]
  turns     Json
  // Set when finished: per-question scores, communication, gaps, next steps.
  scorecard Json?
  // Overall 0-100, copied out of the scorecard for history and progress.
  score     Int?
  // The session this one repeats (same questions).
  retry_of_id String? @db.ObjectId
  // How it was set up (interview.ts Setup): { target: job|paste|general, style, format,
  // round?, focus?, role?, skill?, length }. Optional: older rows are job / real / standard.
  setup Json?

  created_at   DateTime  @default(now())
  completed_at DateTime?

  @@index([job_seeker_id, created_at])
  @@map("mock_interviews")
}

// ========== job.prisma ==========

enum JobSource {
    // A link the seeker pasted (POST /job-seeker/jobs/by-url); the apply page is wherever the link goes.
    MANUAL
    WORKABLE
    LEVER
    LINKEDIN
    GREENHOUSE
    ASHBY
    // A company's own career site on any other hiring system (Workday, SuccessFactors, Oracle...).
    CAREER_SITE
    INDEED
    GOOGLE_JOBS
    ZIPRECRUITER
    GLASSDOOR
    TALENT
    JOBBANK
    JOBILLICO
    DICE
    HANDSHAKE
    BUILTIN
    WUZZUF
    REMOTIVE
    JOBICY
    REMOTEOK
    HIMALAYAS
    JOOBLE
    ADZUNA
    // Fantastic.jobs: employers' own hiring systems, an opt-in paid feed (USE_FANTASTIC_JOBS).
    FANTASTIC_JOBS
    BAYT
    NAUKRIGULF
    GULFTALENT
    WEWORKREMOTELY
    WORKINGNOMADS
    WELLFOUND
    ARC
    DYNAMITEJOBS
    JOBGETHER
    NODESK
}

enum JobRemoteType {
    ONSITE
    HYBRID
    REMOTE
    UNKNOWN
}

model Job {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  source JobSource

  // Dedupe key: same posting from the same source should never be stored twice.
  external_id String

  title       String
  company     String
  company_url String?
  location    String?
  remote_type JobRemoteType @default(UNKNOWN)
  job_type    String?
  easy_apply  Boolean       @default(false)

  url         String
  apply_url   String?
  description String?

  salary_min      Int?
  salary_max      Int?
  salary_currency String?

  posted_at DateTime?
  raw       Json?

  // Set at ingest: what kind of job this is, and a key that is the same for
  // the same posting arriving from different boards (company + title + place).
  profession  String?
  employment  String?
  dedupe_key  String?
  // The posting was found closed. Hidden from results; checked_at is when we last looked.
  expired_at  DateTime?
  checked_at  DateTime?

  matches      JobSeekerJobMatch[]
  applications JobApplication[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([source, external_id])
  @@index([dedupe_key])
  @@index([checked_at])
  // Job alerts walk new jobs in the order they entered the index.
  @@index([created_at])
  @@map("jobs")
}

enum DiscoveryRunStatus {
    RUNNING
    DONE
    FAILED
}

// One background discovery execution. `progress` mirrors RunProgress
// (stage + per-source counts) so the UI can animate the pipeline live.
model DiscoveryRun {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  thread_id String?     @db.ObjectId
  thread    ChatThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)

  status   DiscoveryRunStatus @default(RUNNING)
  query    Json
  progress Json?
  fetched  Int  @default(0)
  matched  Int  @default(0)
  error    String?

  // The seeker starred this search on the web; the extension lists it first.
  // Optional on purpose: older rows have no value and Mongo rejects a missing required field.
  featured Boolean?

  matches JobSeekerJobMatch[]

  started_at  DateTime  @default(now())
  finished_at DateTime?

  @@index([job_seeker_id, started_at])
  @@index([thread_id])
  @@map("discovery_runs")
}

model JobSeekerJobMatch {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  job_id String @db.ObjectId
  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // Every run that surfaced this job for this seeker (a job can appear in
  // several searches); `discovery_run_id` is the most recent one.
  discovery_run_ids String[]      @default([]) @db.ObjectId
  discovery_run_id  String?       @db.ObjectId
  discovery_run     DiscoveryRun? @relation(fields: [discovery_run_id], references: [id], onDelete: SetNull)

  discovered_at DateTime @default(now())

  // Layer 2 (BM25 keyword scoring against the seeker's skills/titles/experience).
  // Null until ranked; shortlisted marks the top slice kept after ranking.
  match_score Float?
  shortlisted Boolean @default(false)

  // Seeker actions on this match.
  saved    Boolean   @default(false)
  saved_at DateTime?
  hidden   Boolean   @default(false)

  // Added to the browser-extension queue from the web ("Apply"): the extension pre-ticks these.
  // Optional on purpose: older rows have no value.
  extension_queued Boolean?

  @@unique([job_seeker_id, job_id])
  @@index([job_seeker_id])
  @@index([job_seeker_id, shortlisted])
  @@index([job_seeker_id, saved])
  @@index([discovery_run_id])
  @@index([discovery_run_ids])
  @@map("job_seeker_job_matches")
}

enum JobApplicationStatus {
    QUEUED
    IN_PROGRESS
    // Waiting on the seeker: unanswered questions, drafts to confirm, or a
    // CAPTCHA only a human can pass.
    NEEDS_INPUT
    // The site is asking for a person (CAPTCHA / "verify you are human").
    // Plato never solves it: a person completes it, then the flow continues.
    NEEDS_USER_VERIFICATION
    SUBMITTED
    FAILED
    // The posting closed before we could apply.
    EXPIRED
    // Plato decided not to apply: not a fit, or the same role was already handled.
    SKIPPED
    // Claimed by the Chrome extension apply engine. Holds the duplicate lock
    // while a person works through the form; the legacy worker never touches it.
    EXTENSION_ACTIVE
}

// Who runs an application. Null (rows from before the extension) = LEGACY.
// What the seeker heard back, marked by the seeker (optional): Plato doesn't read
// employer replies, so this is the only source for "Interview" on Home.
enum ApplicationOutcome {
    VIEWED
    INTERVIEW
    OFFER
    REJECTED
}

enum ApplyEngine {
    LEGACY
    EXTENSION
}

// A job the seeker asked Plato to apply to. Plato's apply agent (later)
// moves it QUEUED → IN_PROGRESS → SUBMITTED / FAILED.
model JobApplication {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  job_id String @db.ObjectId
  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  thread_id String? @db.ObjectId

  status JobApplicationStatus @default(QUEUED)
  // Null = LEGACY. EXTENSION rows are never queued, retried or withdrawn by
  // the legacy worker/endpoints.
  engine ApplyEngine?
  // EXTENSION engine: the attempt whose VERIFY the seeker was told about.
  // Set when an item enters VERIFY (once per attempt: dedupes the
  // notification across retries and reconciliation), cleared on a new claim.
  // status EXTENSION_ACTIVE + this set = waiting for the seeker to settle it.
  verify_attempt String?
  error  String?
  // Why it didn't go through, as a stable key for stats and UI:
  // human_check | unknown_fact | invalid_answer | ineligible | duplicate |
  // closed | site_error | unsupported | dry_run | no_resume
  failure_kind String?

  // Retry bookkeeping for the apply worker.
  attempts        Int       @default(0)
  next_attempt_at DateTime?

  // Questions for the seeker (with Plato's drafts) while NEEDS_INPUT.
  needs_input Json?
  // Answers the seeker confirmed for this application, keyed by field id.
  answers     Json?
  // Storage key of the resume Plato tailored for this job (PDF).
  resume_key  String?
  // The strategy and quality checks that resume was built with.
  resume_strategy Json?
  // What actually happened: payload sent, confirmation text, screenshot.
  evidence    Json?
  // Worker steps of the latest attempt, so "why did it fail" survives restarts.
  events      Json?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  submitted_at DateTime?
  outcome      ApplicationOutcome?
  outcome_at   DateTime?

  @@unique([job_seeker_id, job_id])
  @@index([job_seeker_id, status])
  @@map("job_applications")
}

// ---- Chrome extension apply engine ----

// A browser the seeker paired with the extension. Only the SHA-256 of the
// opaque token is stored.
model ExtensionDevice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  label         String
  token_hash    String   @unique
  scopes        String[]
  ext_version   String?

  created_at      DateTime  @default(now())
  last_used_at    DateTime?
  // 14 days idle (slides on use), 30 days absolute.
  idle_expires_at DateTime
  expires_at      DateTime
  revoked_at      DateTime?

  @@index([job_seeker_id])
  @@map("extension_devices")
}

// A job-site account the extension created for the seeker (owner, 2026-11-21). The password never reaches Plato:
// it is made and kept encrypted in that browser's extension storage. This row is only the reference to it.
model ExtensionSiteAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  device_id     String   @db.ObjectId // the linked browser that holds the password
  ref           String   @unique // the vault entry's id in that browser
  host          String // the site, e.g. acme.wd5.myworkdayjobs.com
  browser       String // e.g. "Chrome 142 on Linux"
  created_at    DateTime @default(now())

  @@index([job_seeker_id])
  @@map("extension_site_accounts")
}

// One-time pairing code typed into the extension. Only its hash is stored.
model ExtensionPairing {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id   String    @db.ObjectId
  code_hash       String    @unique
  expires_at      DateTime
  used_at         DateTime?
  failed_attempts Int       @default(0)
  created_at      DateTime  @default(now())

  @@index([job_seeker_id])
  @@map("extension_pairings")
}

enum ApplyItemState {
    PENDING
    CLAIMED
    PREPARING
    NEEDS_USER
    FILLING
    REVIEW
    // Written BEFORE the page is shown ready to submit. From here on the
    // outcome can only be settled by evidence or by the person.
    AWAITING_SUBMIT
    SUBMITTED_CONFIRMED
    SUBMITTED_ATTESTED
    // The outcome cannot be established safely: a person decides. Never resubmit.
    VERIFY
    FAILED
    SKIPPED
    CANCELLED
}

model ApplyBatch {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  created_at    DateTime @default(now())
  // Where the jobs were picked: the search, so the extension can say "2 jobs from your AI Engineer search".
  search_id     String?  @db.ObjectId
  label         String?
  // "auto" = Submit without stopping unless a sensitive answer is unverified; "review" = stop before every Submit.
  // Unset (a batch made on the web). Submit is held when this OR the seeker's current setting is "review".
  submit_mode   String?

  @@index([job_seeker_id])
  @@map("apply_batches")
}

model ApplyBatchItem {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  batch_id       String         @db.ObjectId
  job_seeker_id  String         @db.ObjectId
  job_id         String         @db.ObjectId
  application_id String?        @db.ObjectId
  provider       String?
  state          ApplyItemState @default(PENDING)
  // Idempotency: a transition is (item, attempt_id, seq); stale attempts get 409.
  attempt_id     String?
  seq            Int            @default(0)
  device_id      String?        @db.ObjectId
  lease_expires_at DateTime?
  // Which resume this application uploads ("profile" | "tailored"). Its own column: `detail` is read-modify-written
  // by every state transition, and a transition in flight used to overwrite the choice saved a moment earlier.
  resume_choice  String?
  // The seeker chose to apply again to a job Plato already marked as sent (the AI can be wrong about a submit).
  reapply        Boolean?
  // Evidence/reason for the latest state (page marker, verify reason, failure_kind).
  detail         Json?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@unique([batch_id, job_id])
  @@index([job_seeker_id, state])
  @@map("apply_batch_items")
}


// ========== plan.prisma ==========

// Plans and top-up packs, edited in the admin panel. A key with no row here uses
// its default from src/modules/credits/credit-prices.ts (no seed script).
// "Deleting" sets active false: it can no longer be bought, accounts on it keep working.
model Plan {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique
  // "plan" (tokens = monthly grant) or "topup" (tokens = pack size)
  kind       String
  label      String
  tokens     Float
  price_usd  Float
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("plans")
}

// ========== quizzes.prisma ==========

// Quiz Builder (src/modules/quizzes): a practice test in a company's own hiring-test format for one role, built by AI
// from a job Plato has or a pasted description. Shapes of the Json fields: src/modules/quizzes/quiz.contract.ts.

model Quiz {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String @db.ObjectId

  title       String // "Amazon · Software Development Engineer"
  company     String?
  company_key String? // normalizeCompany(company).key, for the library
  role        String
  role_family String // normalised role ("software development engineer"), for the library

  source Json // { kind: 'job', job_id } | { kind: 'text', text }

  status String  @default("generating") // generating | ready | failed
  stage  String? // reading | researching | writing (while generating)
  error  String?

  about    String @default("") // what the research found about the company's test
  sources  Json   @default("[]") // [{ title, url }]
  sections Json   @default("[]") // Section[] (questions without keys)
  keys     Json   @default("{}") // questionId -> { key: AnswerKey, explanation }

  library_id String? @db.ObjectId // the shared library entry it came from or was saved as

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id, created_at])
  @@map("quizzes")
}

// The shared library ("vault"): every quiz that passed validation, reusable by other seekers for the same company
// and role family, so a second seeker gets it instantly and without AI cost.
model QuizLibrary {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company_key String // "" when no company
  company     String?
  role_family String
  role        String
  title       String

  about    String @default("")
  sources  Json   @default("[]")
  sections Json
  keys     Json

  times_taken Int @default(0)

  created_at DateTime @default(now())

  @@index([company_key, role_family, created_at])
  @@map("quiz_library")
}

model QuizAttempt {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  quiz_id       String @db.ObjectId
  job_seeker_id String @db.ObjectId

  answers Json // questionId -> Answer
  result  Json // AttemptResult without id/quizId/createdAt
  score   Int // 0-100
  seconds Int

  created_at DateTime @default(now())

  @@index([quiz_id, created_at])
  @@index([job_seeker_id, created_at])
  @@map("quiz_attempts")
}

// Standard assessments (fixed item banks in data/assessments; shapes in quiz.contract.ts).
model AssessmentAttempt {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String @db.ObjectId
  slug          String // "matrix-3", "big-five"

  answers  Json // item id -> AssessmentAnswer
  result   Json // AssessmentResult without id/createdAt
  headline String
  seconds  Int

  created_at DateTime @default(now())

  @@index([job_seeker_id, slug, created_at])
  @@map("assessment_attempts")
}

// The AI-written candidate report, one per seeker, rewritten on request when newer attempts exist.
model CandidateReport {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String @unique @db.ObjectId
  basis         String // the newest attempt id it was written from
  report        Json // CandidateReport

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("candidate_reports")
}

// ========== resume.prisma ==========

// The candidate profile is the source of truth for everything a resume says.
// Resumes are generated from these rows and never store facts of their own.

enum AchievementSource {
  USER
  EXTRACTED
}

model JobSeekerProject {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  name         String
  role         String?
  description  String
  technologies String[] @default([])
  url          String?
  // What it achieved, in the seeker's words (numbers only if they gave them).
  result       String?

  created_at DateTime @default(now())

  @@index([job_seeker_id])
  @@map("job_seeker_projects")
}

// One verified statement about impact. Linked to an employer or a project by
// name (not id), so it survives a full profile replace.
model JobSeekerAchievement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  company      String?
  project_name String?
  text         String
  // The number or measure exactly as the seeker stated it, e.g. "40%".
  metric       String?
  source       AchievementSource @default(USER)

  created_at DateTime @default(now())

  @@index([job_seeker_id])
  @@map("job_seeker_achievements")
}

// Proof behind a skill claim. A skill with evidence may appear on a resume
// even when the CV never listed it.
model JobSeekerSkillEvidence {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  skill     String
  // Lowercased skill, for the unique key.
  skill_key String
  // WORKING | STRONG
  level     String
  proof     String
  url       String?

  confirmed_at DateTime @default(now())

  @@unique([job_seeker_id, skill_key])
  @@map("job_seeker_skill_evidence")
}

model JobSeekerResumeSettings {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @unique @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  // Shown only where the market expects it, and only if the seeker agreed.
  nationality      String?
  // Per market choices the seeker made: { EG: { personalBlock: false } }.
  market_overrides Json?

  updated_at DateTime @updatedAt

  @@map("job_seeker_resume_settings")
}

// A course or certification the seeker is taking or finished for a skill.
// Only a COMPLETED one whose link we could check (VERIFIED) is added to the
// profile; a self-reported one is listed but never used as evidence.
model SkillCredential {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  skill          String
  // Catalogue id when it came from the list, null for a custom one.
  course_id      String?
  title          String
  provider       String?
  // IN_PROGRESS | COMPLETED
  status         String
  credential_url String?
  // An uploaded certificate (a CERTIFICATE document of this seeker).
  document_id    String?   @db.ObjectId

  // SELF_REPORTED | VERIFIED
  verification      String    @default("SELF_REPORTED")
  verification_note String?
  verified_issuer   String?
  verified_at       DateTime?
  completed_at      DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id])
  @@map("skill_credentials")
}

// ========== usage.prisma ==========

// One row per LLM run or Apify actor run. Basis for plan pricing/quotas.
// user_id is the auth User id (null for background work with no request).
model UsageEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id       String?  @db.ObjectId
  feature       String
  model         String?
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  apify_usd     Float    @default(0)
  // Estimated dollars for this event (tokens x price table, or Apify's own figure).
  cost_usd      Float?
  // Extra detail, e.g. a voice call's audio/text token split and seconds.
  meta          Json?
  // The job search (DiscoveryRun) this cost belongs to, so the admin panel can price
  // each search. Null for everything else, and for events from before it was recorded.
  discovery_run_id String? @db.ObjectId
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@index([feature, created_at])
  @@index([discovery_run_id])
  @@map("usage_events")
}

// How a seeker uses the web app, one row per user, UTC day and page: page views and
// seconds on the page (a heartbeat while the tab is visible). Pages are route shapes
// ("/applications/:id"), never ids, queries or what is on the page.
model PageActivity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  day        String
  page       String
  views      Int      @default(0)
  seconds    Int      @default(0)
  first_at   DateTime @default(now())
  last_at    DateTime @default(now())

  @@unique([user_id, day, page])
  @@index([day])
  @@map("page_activity")
}

// ========== user.prisma ==========

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  full_name String
  email String  @unique
  phone String  @unique
  password_hash String
  gender Gender @default(OTHER)

  // Set when the seeker opens the link in the confirmation email.
  email_verified_at    DateTime?
  // Sessions issued before this are refused (set by a password reset).
  sessions_valid_after DateTime?
  // Blocked by an admin: no login, and every session and extension token is refused (403 BLOCKED).
  blocked_at     DateTime?
  blocked_reason String?

  job_seeker JobSeeker?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model JobSeeker {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  user_id String @unique @db.ObjectId
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  bio          String?
  avatar_url   String?
  location     Json?
  website      String?
  birth_date   DateTime?
  skills       String[] @default([])

  current_document_version_id String? @db.ObjectId

  // Answer bank: screening answers the seeker confirmed once, reused on
  // later applications. Keyed by normalised question text.
  apply_answers Json?
  // Intake facts employers ask for that live nowhere else in the profile
  // (current salary, English level, country, optional sensitive ones...).
  // Keyed by the intake bank's keys (src/modules/apply/intake.ts).
  apply_facts   Json?

  social_links     JobSeekerSocialLink[]
  documents        JobSeekerDocument[]
  document_versions JobSeekerDocumentVersion[]
  preferences      JobSeekerPreference?
  experiences      JobSeekerExperience[]
  educations       JobSeekerEducation[]
  job_matches      JobSeekerJobMatch[]
  job_applications JobApplication[]
  chat_threads     ChatThread[]
  career_threads   CareerThread[]
  career_resumes   CareerResume[]
  mock_interviews  MockInterview[]
  projects         JobSeekerProject[]
  achievements     JobSeekerAchievement[]
  skill_evidence   JobSeekerSkillEvidence[]
  skill_credentials SkillCredential[]
  resume_settings  JobSeekerResumeSettings?
  discovery_runs   DiscoveryRun[]
  certifications   JobSeekerCertification[]
  languages        JobSeekerLanguage[]
  profile_evaluation JobSeekerProfileEvaluation?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("job_seekers")

  // Browser-extension run settings (extension/settings.ts). Optional: older rows have none.
  extension_settings Json?
}

model JobSeekerDocumentVersion {
