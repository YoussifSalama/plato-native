// ========== datasource.prisma ==========

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DB_URI")
}

// ========== career.prisma ==========

// The Career assistant: its own chat, separate from the job-search threads.

model CareerThread {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  title String?
  messages CareerMessage[]
  resumes  CareerResume[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id, updated_at])
  @@map("career_threads")
}

model CareerMessage {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  thread_id String       @db.ObjectId
  thread    CareerThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  role    ChatRole
  content String
  // Rich result shown under the message, e.g. { type: "resume", resumeId, title }.
  ui      Json?

  created_at DateTime @default(now())

  @@index([thread_id, created_at])
  @@map("career_messages")
}

// A resume Plato built in the Career chat (PDF in object storage).
model CareerResume {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  thread_id String?       @db.ObjectId
  thread    CareerThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)

  title        String
  target_role  String?
  storage_key  String
  // How the resume was built: market, stage, format, pages, template, checks.
  strategy     Json?

  // The document the PDF was drawn from, so it can be edited and redrawn.
  doc             Json?
  // The posting it was tailored to, kept to regenerate a bullet for the same job.
  job_description String?
  // Versions of the resume for one target role: 1, 2, 3... A new edit is a new version.
  version         Int      @default(1)
  parent_id       String?  @db.ObjectId
  // The one version per role the seeker approved for applications.
  approved        Boolean  @default(false)
  edited          Boolean  @default(false)

  created_at DateTime @default(now())

  @@index([job_seeker_id, created_at])
  @@map("career_resumes")
}

// ========== chat.prisma ==========

enum ChatRole {
    USER
    ASSISTANT
}

// One thread = one job-search conversation. Notifications and results link
// back to a thread id, so it doubles as the "search session" id.
model ChatThread {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  title String?

  messages       ChatMessage[]
  discovery_runs DiscoveryRun[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id, created_at])
  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  thread_id String     @db.ObjectId
  thread    ChatThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  role    ChatRole
  content String
  // Interactive card the assistant attached (questions to answer in the
  // chat UI). Answers come back as the next user message.
  ui      Json?

  created_at DateTime @default(now())

  @@index([thread_id, created_at])
  @@map("chat_messages")
}

// ========== credits.prisma ==========

// Plato tokens: the seeker's spending balance. One account per auth User; every
// metered usage event (usage_events) is converted to tokens by its real cost and
// written to the ledger. See src/modules/credits/credit-prices.ts for the rates.
model CreditAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @unique @db.ObjectId
  plan         String   @default("free")
  // Plato tokens left in this period. Fractional (a cheap chat message is
  // ~1 token); may dip slightly below zero when a call finishes after the
  // balance ran out. Reset to the plan's grant at period_end.
  balance      Float    @default(0)
  // Tokens bought as top-ups, included in balance. They are spent last and
  // never expire: what is left of them, min(topup, balance), carries over
  // the monthly reset and a plan change.
  topup        Float    @default(0)
  period_start DateTime
  period_end   DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("credit_accounts")
}

// Every change to a balance, append-only: grant (plan grant or monthly reset),
// consume (a metered usage event), hold / release (a reservation), adjust (admin).
model CreditLedger {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String   @db.ObjectId
  kind           String
  // Signed: negative for consume.
  amount         Float
  balance_after  Float
  feature        String?
  usage_event_id String?  @db.ObjectId
  // A hold (tokens reserved before a call whose cost is known only after it,
  // like a voice interview) is settled once: released back, then the real
  // cost is charged as a consume.
  settled_at     DateTime?
  meta           Json?
  created_at     DateTime @default(now())

  @@index([user_id, created_at])
  @@map("credit_ledger")
}

// ========== enum.prisma ==========

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum JobSeekerDocumentType {
    CV_RESUME
    CERTIFICATE
    LICENSE
    DEGREE
    OTHER
}

enum JobSeekerDocumentStatus {
    UPLOADED
    PROCESSING
    TEXT_EXTRACTED
    READY
    FAILED
}

enum SectionStatus {
    LOOKS_GOOD
    NEEDS_ATTENTION
}

// ========== interview.prisma ==========

// A text mock interview tied to a listed job. Questions are generated once from
// the posting; a retry copies them into a new session.
model MockInterview {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  // Snapshot of the job: the posting may later expire or change.
  job_id          String? @db.ObjectId
  job_title       String
  company         String
  job_description String

  // [{ kind, question, answer?, followUp?, followUpAnswer? }]
  turns     Json
  // Set when finished: per-question scores, communication, gaps, next steps.
  scorecard Json?
  // Overall 0-100, copied out of the scorecard for history and progress.
  score     Int?
  // The session this one repeats (same questions).
  retry_of_id String? @db.ObjectId

  created_at   DateTime  @default(now())
  completed_at DateTime?

  @@index([job_seeker_id, created_at])
  @@map("mock_interviews")
}

// ========== job.prisma ==========

enum JobSource {
    // A link the seeker pasted (POST /job-seeker/jobs/by-url); the apply page is wherever the link goes.
    MANUAL
    WORKABLE
    LEVER
    LINKEDIN
    GREENHOUSE
    ASHBY
    INDEED
    GOOGLE_JOBS
    ZIPRECRUITER
    GLASSDOOR
    TALENT
    JOBBANK
    JOBILLICO
    DICE
    HANDSHAKE
    BUILTIN
    WUZZUF
    REMOTIVE
    JOBICY
    REMOTEOK
    HIMALAYAS
    JOOBLE
    ADZUNA
    BAYT
    NAUKRIGULF
    GULFTALENT
    WEWORKREMOTELY
    WORKINGNOMADS
    WELLFOUND
    ARC
    DYNAMITEJOBS
    JOBGETHER
    NODESK
}

enum JobRemoteType {
    ONSITE
    HYBRID
    REMOTE
    UNKNOWN
}

model Job {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  source JobSource

  // Dedupe key: same posting from the same source should never be stored twice.
  external_id String

  title       String
  company     String
  company_url String?
  location    String?
  remote_type JobRemoteType @default(UNKNOWN)
  job_type    String?
  easy_apply  Boolean       @default(false)

  url         String
  apply_url   String?
  description String?

  salary_min      Int?
  salary_max      Int?
  salary_currency String?

  posted_at DateTime?
  raw       Json?

  // Set at ingest: what kind of job this is, and a key that is the same for
  // the same posting arriving from different boards (company + title + place).
  profession  String?
  employment  String?
  dedupe_key  String?
  // The posting was found closed. Hidden from results; checked_at is when we last looked.
  expired_at  DateTime?
  checked_at  DateTime?

  matches      JobSeekerJobMatch[]
  applications JobApplication[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([source, external_id])
  @@index([dedupe_key])
  @@index([checked_at])
  @@map("jobs")
}

enum DiscoveryRunStatus {
    RUNNING
    DONE
    FAILED
}

// One background discovery execution. `progress` mirrors RunProgress
// (stage + per-source counts) so the UI can animate the pipeline live.
model DiscoveryRun {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  thread_id String?     @db.ObjectId
  thread    ChatThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)

  status   DiscoveryRunStatus @default(RUNNING)
  query    Json
  progress Json?
  fetched  Int  @default(0)
  matched  Int  @default(0)
  error    String?

  // The seeker starred this search on the web; the extension lists it first.
  // Optional on purpose: older rows have no value and Mongo rejects a missing required field.
  featured Boolean?

  matches JobSeekerJobMatch[]

  started_at  DateTime  @default(now())
  finished_at DateTime?

  @@index([job_seeker_id, started_at])
  @@index([thread_id])
  @@map("discovery_runs")
}

model JobSeekerJobMatch {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  job_id String @db.ObjectId
  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // Every run that surfaced this job for this seeker (a job can appear in
  // several searches); `discovery_run_id` is the most recent one.
  discovery_run_ids String[]      @default([]) @db.ObjectId
  discovery_run_id  String?       @db.ObjectId
  discovery_run     DiscoveryRun? @relation(fields: [discovery_run_id], references: [id], onDelete: SetNull)

  discovered_at DateTime @default(now())

  // Layer 2 (BM25 keyword scoring against the seeker's skills/titles/experience).
  // Null until ranked; shortlisted marks the top slice kept after ranking.
  match_score Float?
  shortlisted Boolean @default(false)

  // Seeker actions on this match.
  saved    Boolean   @default(false)
  saved_at DateTime?
  hidden   Boolean   @default(false)

  // Added to the browser-extension queue from the web ("Apply"): the extension pre-ticks these.
  // Optional on purpose: older rows have no value.
  extension_queued Boolean?

  @@unique([job_seeker_id, job_id])
  @@index([job_seeker_id])
  @@index([job_seeker_id, shortlisted])
  @@index([job_seeker_id, saved])
  @@index([discovery_run_id])
  @@index([discovery_run_ids])
  @@map("job_seeker_job_matches")
}

enum JobApplicationStatus {
    QUEUED
    IN_PROGRESS
    // Waiting on the seeker: unanswered questions, drafts to confirm, or a
    // CAPTCHA only a human can pass.
    NEEDS_INPUT
    // The site is asking for a person (CAPTCHA / "verify you are human").
    // Plato never solves it: a person completes it, then the flow continues.
    NEEDS_USER_VERIFICATION
    SUBMITTED
    FAILED
    // The posting closed before we could apply.
    EXPIRED
    // Plato decided not to apply: not a fit, or the same role was already handled.
    SKIPPED
    // Claimed by the Chrome extension apply engine. Holds the duplicate lock
    // while a person works through the form; the legacy worker never touches it.
    EXTENSION_ACTIVE
}

// Who runs an application. Null (rows from before the extension) = LEGACY.
enum ApplyEngine {
    LEGACY
    EXTENSION
}

// A job the seeker asked Plato to apply to. Plato's apply agent (later)
// moves it QUEUED → IN_PROGRESS → SUBMITTED / FAILED.
model JobApplication {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  job_id String @db.ObjectId
  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  thread_id String? @db.ObjectId

  status JobApplicationStatus @default(QUEUED)
  // Null = LEGACY. EXTENSION rows are never queued, retried or withdrawn by
  // the legacy worker/endpoints.
  engine ApplyEngine?
  // EXTENSION engine: the attempt whose VERIFY the seeker was told about.
  // Set when an item enters VERIFY (once per attempt: dedupes the
  // notification across retries and reconciliation), cleared on a new claim.
  // status EXTENSION_ACTIVE + this set = waiting for the seeker to settle it.
  verify_attempt String?
  error  String?
  // Why it didn't go through, as a stable key for stats and UI:
  // human_check | unknown_fact | invalid_answer | ineligible | duplicate |
  // closed | site_error | unsupported | dry_run | no_resume
  failure_kind String?

  // Retry bookkeeping for the apply worker.
  attempts        Int       @default(0)
  next_attempt_at DateTime?

  // Questions for the seeker (with Plato's drafts) while NEEDS_INPUT.
  needs_input Json?
  // Answers the seeker confirmed for this application, keyed by field id.
  answers     Json?
  // Storage key of the resume Plato tailored for this job (PDF).
  resume_key  String?
  // The strategy and quality checks that resume was built with.
  resume_strategy Json?
  // What actually happened: payload sent, confirmation text, screenshot.
  evidence    Json?
  // Worker steps of the latest attempt, so "why did it fail" survives restarts.
  events      Json?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  submitted_at DateTime?

  @@unique([job_seeker_id, job_id])
  @@index([job_seeker_id, status])
  @@map("job_applications")
}

// ---- Chrome extension apply engine ----

// A browser the seeker paired with the extension. Only the SHA-256 of the
// opaque token is stored.
model ExtensionDevice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  label         String
  token_hash    String   @unique
  scopes        String[]
  ext_version   String?

  created_at      DateTime  @default(now())
  last_used_at    DateTime?
  // 14 days idle (slides on use), 30 days absolute.
  idle_expires_at DateTime
  expires_at      DateTime
  revoked_at      DateTime?

  @@index([job_seeker_id])
  @@map("extension_devices")
}

// One-time pairing code typed into the extension. Only its hash is stored.
model ExtensionPairing {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id   String    @db.ObjectId
  code_hash       String    @unique
  expires_at      DateTime
  used_at         DateTime?
  failed_attempts Int       @default(0)
  created_at      DateTime  @default(now())

  @@index([job_seeker_id])
  @@map("extension_pairings")
}

enum ApplyItemState {
    PENDING
    CLAIMED
    PREPARING
    NEEDS_USER
    FILLING
    REVIEW
    // Written BEFORE the page is shown ready to submit. From here on the
    // outcome can only be settled by evidence or by the person.
    AWAITING_SUBMIT
    SUBMITTED_CONFIRMED
    SUBMITTED_ATTESTED
    // The outcome cannot be established safely: a person decides. Never resubmit.
    VERIFY
    FAILED
    SKIPPED
    CANCELLED
}

model ApplyBatch {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  created_at    DateTime @default(now())
  // Where the jobs were picked: the search, so the extension can say "2 jobs from your AI Engineer search".
  search_id     String?  @db.ObjectId
  label         String?

  @@index([job_seeker_id])
  @@map("apply_batches")
}

model ApplyBatchItem {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  batch_id       String         @db.ObjectId
  job_seeker_id  String         @db.ObjectId
  job_id         String         @db.ObjectId
  application_id String?        @db.ObjectId
  provider       String?
  state          ApplyItemState @default(PENDING)
  // Idempotency: a transition is (item, attempt_id, seq); stale attempts get 409.
  attempt_id     String?
  seq            Int            @default(0)
  device_id      String?        @db.ObjectId
  lease_expires_at DateTime?
  // Which resume this application uploads ("profile" | "tailored"). Its own column: `detail` is read-modify-written
  // by every state transition, and a transition in flight used to overwrite the choice saved a moment earlier.
  resume_choice  String?
  // Evidence/reason for the latest state (page marker, verify reason, failure_kind).
  detail         Json?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@unique([batch_id, job_id])
  @@index([job_seeker_id, state])
  @@map("apply_batch_items")
}


// ========== resume.prisma ==========

// The candidate profile is the source of truth for everything a resume says.
// Resumes are generated from these rows and never store facts of their own.

enum AchievementSource {
  USER
  EXTRACTED
}

model JobSeekerProject {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  name         String
  role         String?
  description  String
  technologies String[] @default([])
  url          String?
  // What it achieved, in the seeker's words (numbers only if they gave them).
  result       String?

  created_at DateTime @default(now())

  @@index([job_seeker_id])
  @@map("job_seeker_projects")
}

// One verified statement about impact. Linked to an employer or a project by
// name (not id), so it survives a full profile replace.
model JobSeekerAchievement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  company      String?
  project_name String?
  text         String
  // The number or measure exactly as the seeker stated it, e.g. "40%".
  metric       String?
  source       AchievementSource @default(USER)

  created_at DateTime @default(now())

  @@index([job_seeker_id])
  @@map("job_seeker_achievements")
}

// Proof behind a skill claim. A skill with evidence may appear on a resume
// even when the CV never listed it.
model JobSeekerSkillEvidence {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  skill     String
  // Lowercased skill, for the unique key.
  skill_key String
  // WORKING | STRONG
  level     String
  proof     String
  url       String?

  confirmed_at DateTime @default(now())

  @@unique([job_seeker_id, skill_key])
  @@map("job_seeker_skill_evidence")
}

model JobSeekerResumeSettings {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @unique @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  // Shown only where the market expects it, and only if the seeker agreed.
  nationality      String?
  // Per market choices the seeker made: { EG: { personalBlock: false } }.
  market_overrides Json?

  updated_at DateTime @updatedAt

  @@map("job_seeker_resume_settings")
}

// A course or certification the seeker is taking or finished for a skill.
// Only a COMPLETED one whose link we could check (VERIFIED) is added to the
// profile; a self-reported one is listed but never used as evidence.
model SkillCredential {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  skill          String
  // Catalogue id when it came from the list, null for a custom one.
  course_id      String?
  title          String
  provider       String?
  // IN_PROGRESS | COMPLETED
  status         String
  credential_url String?
  // An uploaded certificate (a CERTIFICATE document of this seeker).
  document_id    String?   @db.ObjectId

  // SELF_REPORTED | VERIFIED
  verification      String    @default("SELF_REPORTED")
  verification_note String?
  verified_issuer   String?
  verified_at       DateTime?
  completed_at      DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([job_seeker_id])
  @@map("skill_credentials")
}

// ========== usage.prisma ==========

// One row per LLM run or Apify actor run. Basis for plan pricing/quotas.
// user_id is the auth User id (null for background work with no request).
model UsageEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id       String?  @db.ObjectId
  feature       String
  model         String?
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  apify_usd     Float    @default(0)
  // Estimated dollars for this event (tokens x price table, or Apify's own figure).
  cost_usd      Float?
  // Extra detail, e.g. a voice call's audio/text token split and seconds.
  meta          Json?
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@index([feature, created_at])
  @@map("usage_events")
}

// ========== user.prisma ==========

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  full_name String
  email String  @unique
  phone String  @unique
  password_hash String
  gender Gender @default(OTHER)

  job_seeker JobSeeker?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model JobSeeker {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  user_id String @unique @db.ObjectId
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  bio          String?
  avatar_url   String?
  location     Json?
  website      String?
  birth_date   DateTime?
  skills       String[] @default([])

  current_document_version_id String? @db.ObjectId

  // Answer bank: screening answers the seeker confirmed once, reused on
  // later applications. Keyed by normalised question text.
  apply_answers Json?
  // Intake facts employers ask for that live nowhere else in the profile
  // (current salary, English level, country, optional sensitive ones...).
  // Keyed by the intake bank's keys (src/modules/apply/intake.ts).
  apply_facts   Json?

  social_links     JobSeekerSocialLink[]
  documents        JobSeekerDocument[]
  document_versions JobSeekerDocumentVersion[]
  preferences      JobSeekerPreference?
  experiences      JobSeekerExperience[]
  educations       JobSeekerEducation[]
  job_matches      JobSeekerJobMatch[]
  job_applications JobApplication[]
  chat_threads     ChatThread[]
  career_threads   CareerThread[]
  career_resumes   CareerResume[]
  mock_interviews  MockInterview[]
  projects         JobSeekerProject[]
  achievements     JobSeekerAchievement[]
  skill_evidence   JobSeekerSkillEvidence[]
  skill_credentials SkillCredential[]
  resume_settings  JobSeekerResumeSettings?
  discovery_runs   DiscoveryRun[]
  certifications   JobSeekerCertification[]
  languages        JobSeekerLanguage[]
  profile_evaluation JobSeekerProfileEvaluation?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("job_seekers")

  // Browser-extension run settings (extension/settings.ts). Optional: older rows have none.
  extension_settings Json?
}

model JobSeekerDocumentVersion {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  version_number     Int
  analyzed_at        DateTime?
  replacement_count  Int @default(0)

  documents JobSeekerDocument[]

  created_at DateTime @default(now())

  @@unique([job_seeker_id, version_number])
  @@map("job_seeker_document_versions")
}

