# Copy to /opt/plato/.env on the server (and to ./.env for a local smoke test). Never commit it.
# docker-compose.yml reads LANDING_DOMAIN, WEB_DOMAIN, API_DOMAIN and MONGO_ROOT_PASSWORD; everything else goes to the API as is.
# DB_URI, FRONTEND_URL, API_PUBLIC_URL, PORT and TRUST_PROXY are set by the compose file: do not put them here.

# --- Hosting -------------------------------------------------------------------
LANDING_DOMAIN=plato.example.com
WEB_DOMAIN=job.plato.example.com
API_DOMAIN=api.plato.example.com
MONGO_ROOT_PASSWORD=
EXTENSION_ORIGIN=chrome-extension://<the extension id>

# --- Required by the API (see plato-native-be/.env.example for the full list) -----
JWT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_CLIENT_API=
CLOUDFLARE_BUCKET_NAME=

# --- Email ---------------------------------------------------------------------
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# --- Job sources ---------------------------------------------------------------
APIFY_TOKEN=
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Admin / monitoring --------------------------------------------------------
ADMIN_REPORT_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
