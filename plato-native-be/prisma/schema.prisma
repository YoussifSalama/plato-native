model JobSeekerPreference {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String    @unique @db.ObjectId
  job_seeker    JobSeeker @relation(fields: [job_seeker_id], references: [id], onDelete: Cascade)

  email_notifications Boolean @default(true)
  push_notifications  Boolean @default(true)
  ai_recommendations  Boolean @default(true)

  roles                String[] @default([])
  preferred_job_types  String[]
  preferred_industries String[]
  preferred_locations  String[]
  work_setup           String[] @default([])
  salary_min           Int?
  salary_max           Int?
  salary_currency      String?
  salary_period        String   @default("MONTHLY")
  things_to_avoid      String? // older free text; replaced by the two lists below
  // Left out of every search (New search shows them, prefilled, under Advanced): companies, and words in a job title.
  avoid_companies      String[] @default([])
  avoid_words          String[] @default([])
  source               String   @default("AI_SUGGESTED")

  seniority                 String?
  years_experience          String?
  availability              String?
  employment_status         String?
  willing_to_relocate       Boolean @default(false)
  visa_sponsorship_required Boolean @default(false)
  // Limits on the two flags above, in the seeker's words ("Gulf only",
  // "only for jobs outside Egypt"). Read by the answer-drafting agent.
  relocation_note           String?
  sponsorship_note          String?
  linkedin_url              String?
  // Application snapshot: facts employers' forms ask for, collected once.
  // Countries the seeker may work in without sponsorship.
  work_authorization        String[] @default([])
  // "Plato may submit applications and accept employer privacy notices for me."
  auto_apply_consent        Boolean  @default(false)
  github_url                String?
  portfolio_url             String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("job_seeker_preferences")
}
// A CV for one search only ("Search with a different CV" on New search): read like the profile's CV, but never
// written to the profile. The search ranks against it and applications from that search send it.
model SearchCv {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  job_seeker_id String   @db.ObjectId
  name          String
  storage_key   String
  text          String
  analysis      Json // CvAnalysis (profile-extraction/cv-analysis.service.ts)
  apply_json    Json? // the extension's CV facts, made once (as on JobSeekerDocument)
  created_at    DateTime @default(now())

  @@index([job_seeker_id])
  @@map("search_cvs")
}
