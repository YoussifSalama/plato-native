# Two hostnames, both from .env. Caddy fetches and renews the certificates itself.
{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3001
}

# www goes to the bare domain
www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode gzip
	# the extension posts screenshots (a few MB) per turn
	request_body {
		max_size 16MB
	}
	reverse_proxy api:3000
}
